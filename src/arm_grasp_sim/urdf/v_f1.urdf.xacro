<?xml version="1.0"?>
<!-- 最小复现：v_skel + 1 个 revolute effort 测试关节 -->
<robot name="ep_f1">
  <link name="world"/>
  <link name="table_link">
    <inertial><mass value="10"/><inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/></inertial>
    <visual><geometry><box size="1.0 0.8 0.05"/></geometry></visual>
    <collision><geometry><box size="1.0 0.8 0.05"/></geometry></collision>
  </link>
  <joint name="table_joint" type="fixed">
    <parent link="world"/><child link="table_link"/><origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <joint name="chassis_yaw_joint" type="revolute">
    <parent link="table_link"/><child link="base_link"/>
    <origin xyz="0 0 0.025" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit effort="4" velocity="3.14" lower="-6.2832" upper="6.2832"/>
  </joint>
  <link name="base_link">
    <inertial><mass value="1.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><geometry><box size="0.2 0.15 0.06"/></geometry></visual>
    <collision><geometry><box size="0.2 0.15 0.06"/></geometry></collision>
  </link>
  <joint name="arm_1_joint" type="revolute">
    <origin xyz="0.0103961 -0.0255713 0.125389" rpy="0 0 0"/>
    <parent link="base_link"/><child link="arm_1_link"/>
    <axis xyz="0 1 0"/><limit effort="6" velocity="3" lower="-0.274" upper="1.384"/>
  </joint>
  <link name="arm_1_link">
    <inertial><mass value="0.056"/><inertia ixx="0.0156113" ixy="0" ixz="0" iyy="0.0161553" iyz="0" izz="0.0018092"/></inertial>
    <visual><geometry><box size="0.03 0.03 0.12"/></geometry></visual>
    <collision><geometry><box size="0.03 0.03 0.12"/></geometry></collision>
  </link>
  <joint name="arm_2_joint" type="revolute">
    <origin xyz="0.0018704 0.0438659 0.1210238" rpy="0 0 0"/>
    <parent link="arm_1_link"/><child link="arm_2_link"/>
    <axis xyz="0 1 0"/><limit effort="6" velocity="3" lower="-1.25" upper="0.40"/>
  </joint>
  <link name="arm_2_link">
    <inertial><mass value="0.08"/><inertia ixx="0.0118624" ixy="0" ixz="0" iyy="0.0041691" iyz="0" izz="0.0101456"/></inertial>
    <visual><geometry><box size="0.03 0.03 0.12"/></geometry></visual>
    <collision><geometry><box size="0.03 0.03 0.12"/></geometry></collision>
  </link>
  <joint name="endpoint_bracket_joint" type="revolute">
    <origin xyz="0.1058557 0.006752 -0.0561093" rpy="0 0 0"/>
    <parent link="arm_2_link"/><child link="endpoint_bracket_link"/>
    <axis xyz="0 1 0"/><limit effort="6" velocity="3" lower="-3.14" upper="3.14"/>
  </joint>
  <link name="endpoint_bracket_link">
    <inertial><mass value="0.028"/><inertia ixx="0.0004413" ixy="0" ixz="0" iyy="0.0008301" iyz="0" izz="0.0008237"/></inertial>
    <visual><geometry><box size="0.03 0.03 0.03"/></geometry></visual>
    <collision><geometry><box size="0.03 0.03 0.03"/></geometry></collision>
  </link>
  <!-- 被测： 固定关节链下的 revolute+effort -->
  <joint name="gripper_left_joint" type="revolute">
    <origin xyz="0.0165825 -0.0058228 -0.0397386" rpy="0 0 0"/>
    <parent link="endpoint_bracket_link"/><child link="finger_box"/>
    <axis xyz="0 0 1"/>
    <limit effort="1.2" velocity="2" lower="-0.32" upper="0.45"/>
    <dynamics damping="0.05"/>
  </joint>
  <link name="finger_box">
    <inertial><mass value="0.011"/><inertia ixx="0.006" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.006"/></inertial>
    <visual><geometry><box size="0.02 0.03 0.05"/></geometry></visual>
    <collision><geometry><box size="0.02 0.03 0.05"/></geometry></collision>
  </link>
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <ros><node_name>arm_gazebo_ros2_control</node_name></ros>
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <parameters>/home/underwater/arm_grasp_ws/src/arm_grasp_sim/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>
  <ros2_control name="ep_f1_system" type="system">
    <hardware><plugin>gazebo_ros2_control/GazeboSystem</plugin></hardware>
    <joint name="chassis_yaw_joint"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="arm_1_joint"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="arm_2_joint"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="endpoint_bracket_joint"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="gripper_left_joint"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
  </ros2_control>
</robot>
