  <joint name="right_gripper_joint_6" type="fixed">
    <origin xyz="0.0059278 0.0133069 0" rpy="0 0 0"/>
    <parent link="right_gripper_link_5"/><child link="right_gripper_link_6"/>
  </joint>
  <link name="right_gripper_link_6">
