<?xml version="1.0"?>
<sdf version="1.7">
  <world name="empty_grasp">
    <gui>
      <camera name="user_camera">
        <pose>0 -0.85 0.55 0 0.55 1.5708</pose>
      </camera>
    </gui>
    <include>
      <uri>model://sun</uri>
    </include>
    <scene>
      <ambient>0.75 0.75 0.75 1</ambient>
      <background>0.2 0.2 0.2 1</background>
    </scene>

    <!-- 提供 /gazebo/get_entity_state 与 /gazebo/set_entity_state 服务，
         并周期性发布 /gazebo/model_states 话题（用于诚实验证方块位姿）。
         默认 gazebo.launch.py 只加载 init/factory/force_system，不含本插件，
         导致方块复位与位姿校验均不可用。 -->
    <plugin name="gazebo_ros_state" filename="/opt/ros/humble/lib/libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>20</update_rate>
    </plugin>

    <physics name="default" type="ode">
      <real_time_update_rate>2500</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>200</iters>
          <sor>1.0</sor>
        </solver>
        <constraints>
          <tolerance>0.001</tolerance>
        </constraints>
      </ode>
    </physics>
  </world>
</sdf>
