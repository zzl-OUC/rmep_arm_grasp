<?xml version="1.0"?>
<sdf version="1.7">
  <!-- ============================================================
       实验3 桌面分类场景（网球 + 矿泉水瓶版）
       布局：6 个取物网格(全向) + 2 个分类料盒(正左瓶盒/正右球盒)
       网格 r=0.235(格外移 5cm 避开麦轮):
         cell_1 正前(0.235,0) 球 | cell_2 左前(0.166,0.166) 瓶
         cell_3 右前(0.166,-0.166) 瓶 | cell_4 正后(-0.235,0) 瓶
         cell_5 左后(-0.166,0.166) 球 | cell_6 右后(-0.166,-0.166) 球
       料盒 r=0.21(3面墙, 开口朝中心):
         bin_0 (0, 0.24) 瓶盒(正左) | bin_1 (0, -0.24) 球盒(正右)
       依据：可达圆环 r ∈ [14.46, 25.64] cm（reach_analysis.py 实测）
       注意：桌面本体由 URDF 的 table_link 提供（1.0 x 0.8 m，顶面 z=+0.025），
             本 world 不再重复建桌面，只摆放网格与料盒。
       料盒中性灰(S≈0): 不进 is_colored 掩码, 不与物体轮廓合并。
       ============================================================ -->
  <world name="table_grid">
    <gui>
      <camera name="user_camera">
        <pose>0.75 0 0.55 0 0.588 3.1416</pose>
      </camera>
    </gui>
    <include><uri>model://sun</uri></include>
    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.25 0.25 0.25 1</background>
    </scene>

    <!-- /gazebo/model_states、get/set_entity_state：物体复位与位姿校验依赖 -->
    <plugin name="gazebo_ros_state" filename="/opt/ros/humble/lib/libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>20</update_rate>
    </plugin>

    <physics name="default" type="ode">
      <real_time_update_rate>2500</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver><type>quick</type><iters>200</iters><sor>1.0</sor></solver>
        <constraints><tolerance>0.001</tolerance></constraints>
      </ode>
    </physics>

  <model name="desk_layout">
    <static>true</static>
    <pose frame="">0 0 0 0 0 0</pose>
    <!-- 6 取物网格: 0.09x0.09 薄板, 面向圆心 -->
    <link name="cell_1">
      <pose frame=""> 0.2250  0.0000 0.0270 0 0  0.0000</pose>
      <collision name="cell_1_col">
        <geometry><box><size>0.09 0.09 0.004</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode><torsional><coefficient>0.5</coefficient><patch_radius>0.005</patch_radius><use_patch_radius>1</use_patch_radius></torsional></friction></surface>
      </collision>
    </link>
    <link name="cell_2">
      <pose frame=""> 0.1591  0.1591 0.0270 0 0  0.7854</pose>
      <collision name="cell_2_col">
        <geometry><box><size>0.09 0.09 0.004</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode><torsional><coefficient>0.5</coefficient><patch_radius>0.005</patch_radius><use_patch_radius>1</use_patch_radius></torsional></friction></surface>
      </collision>
    </link>
    <link name="cell_3">
      <pose frame=""> 0.1591 -0.1591 0.0270 0 0 -0.7854</pose>
      <collision name="cell_3_col">
        <geometry><box><size>0.09 0.09 0.004</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode><torsional><coefficient>0.5</coefficient><patch_radius>0.005</patch_radius><use_patch_radius>1</use_patch_radius></torsional></friction></surface>
      </collision>
    </link>
    <link name="cell_4">
      <pose frame="">-0.2250  0.0000 0.0270 0 0 3.1416</pose>
      <collision name="cell_4_col">
        <geometry><box><size>0.09 0.09 0.004</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode><torsional><coefficient>0.5</coefficient><patch_radius>0.005</patch_radius><use_patch_radius>1</use_patch_radius></torsional></friction></surface>
      </collision>
    </link>
    <link name="cell_5">
      <pose frame="">-0.1591  0.1591 0.0270 0 0 2.3562</pose>
      <collision name="cell_5_col">
        <geometry><box><size>0.09 0.09 0.004</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode><torsional><coefficient>0.5</coefficient><patch_radius>0.005</patch_radius><use_patch_radius>1</use_patch_radius></torsional></friction></surface>
      </collision>
    </link>
    <link name="cell_6">
      <pose frame="">-0.1591 -0.1591 0.0270 0 0 -2.3562</pose>
      <collision name="cell_6_col">
        <geometry><box><size>0.09 0.09 0.004</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode><torsional><coefficient>0.5</coefficient><patch_radius>0.005</patch_radius><use_patch_radius>1</use_patch_radius></torsional></friction></surface>
      </collision>
    </link>
    <!-- bin_0 瓶盒(正左, r=0.24): 4 面墙, 底板 0.29x0.29 正方, 内净 0.28x0.285。2026-09-21 沿远离原点方向外扩 y 0.135->0.29, 近墙 y=0.19 保持不动。远墙到 y=0.48 已超桌面 y 边界 0.40 约 8cm, 但 desk_layout 为 <static>true</static>, 悬空只是视觉不影响物理。投放点仍用 BINS(0,+-0.24) 未随盒心外移: 盒心 0.335 会让 dB=0.401 远超投放可达钳制线 DB_MAX=0.306。近墙内壁 y=0.1925 仍避开对角格张开指盒的 y 扫掠(最大 0.1865, 余量 6mm); x 加长为投放错开 0.075 留边 -->
    <link name="bin_0_base">
      <pose frame="">0.0000 0.3350 0.0280 0 0 0.0000</pose>
      <collision name="bin_0_base_col">
        <geometry><box><size>0.29 0.29 0.006</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode><torsional><coefficient>0.5</coefficient><patch_radius>0.005</patch_radius><use_patch_radius>1</use_patch_radius></torsional></friction></surface></collision>
      <visual name="bin_0_base_vis">
        <geometry><box><size>0.29 0.29 0.006</size></box></geometry>
        <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
      </visual>
    </link>
    <link name="bin_0_wall_far">
      <pose frame="">0.0000 0.4800 0.0500 0 0 0.0000</pose>
      <collision name="bin_0_wall_far_col">
        <geometry><box><size>0.29 0.005 0.05</size></box></geometry>
      </collision>
      <visual name="bin_0_wall_far_vis">
        <geometry><box><size>0.29 0.005 0.05</size></box></geometry>
        <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
      </visual>
    </link>
    <link name="bin_0_wall_xa">
      <pose frame="">0.1425 0.3350 0.0325 0 0 0.0000</pose>
      <collision name="bin_0_wall_xa_col">
        <geometry><box><size>0.005 0.29 0.015</size></box></geometry>
      </collision>
      <visual name="bin_0_wall_xa_vis">
        <geometry><box><size>0.005 0.29 0.015</size></box></geometry>
        <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
      </visual>
    </link>
    <link name="bin_0_wall_xb">
      <pose frame="">-0.1425 0.3350 0.0325 0 0 0.0000</pose>
      <collision name="bin_0_wall_xb_col">
        <geometry><box><size>0.005 0.29 0.015</size></box></geometry>
      </collision>
      <visual name="bin_0_wall_xb_vis">
        <geometry><box><size>0.005 0.29 0.015</size></box></geometry>
        <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
      </visual>
    </link>
    <link name="bin_0_wall_near">
      <pose frame="">0.0000 0.1900 0.0325 0 0 0.0000</pose>
      <collision name="bin_0_wall_near_col">
        <geometry><box><size>0.29 0.005 0.015</size></box></geometry>
      </collision>
      <visual name="bin_0_wall_near_vis">
        <geometry><box><size>0.29 0.005 0.015</size></box></geometry>
        <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
      </visual>
    </link>
    <!-- bin_1 球盒(正右, r=0.24): 与 bin_0 镜像, 底板 0.29x0.29 正方, 内净 0.28x0.285。理由同 bin_0 -->
    <link name="bin_1_base">
      <pose frame="">0.0000 -0.3350 0.0280 0 0 0.0000</pose>
      <collision name="bin_1_base_col">
        <geometry><box><size>0.29 0.29 0.006</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode><torsional><coefficient>0.5</coefficient><patch_radius>0.005</patch_radius><use_patch_radius>1</use_patch_radius></torsional></friction></surface></collision>
      <visual name="bin_1_base_vis">
        <geometry><box><size>0.29 0.29 0.006</size></box></geometry>
        <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
      </visual>
    </link>
    <link name="bin_1_wall_far">
      <pose frame="">0.0000 -0.4800 0.0500 0 0 0.0000</pose>
      <collision name="bin_1_wall_far_col">
        <geometry><box><size>0.29 0.005 0.05</size></box></geometry>
      </collision>
      <visual name="bin_1_wall_far_vis">
        <geometry><box><size>0.29 0.005 0.05</size></box></geometry>
        <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
      </visual>
    </link>
    <link name="bin_1_wall_xa">
      <pose frame="">0.1425 -0.3350 0.0325 0 0 0.0000</pose>
      <collision name="bin_1_wall_xa_col">
        <geometry><box><size>0.005 0.29 0.015</size></box></geometry>
      </collision>
      <visual name="bin_1_wall_xa_vis">
        <geometry><box><size>0.005 0.29 0.015</size></box></geometry>
        <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
      </visual>
    </link>
    <link name="bin_1_wall_xb">
      <pose frame="">-0.1425 -0.3350 0.0325 0 0 0.0000</pose>
      <collision name="bin_1_wall_xb_col">
        <geometry><box><size>0.005 0.29 0.015</size></box></geometry>
      </collision>
      <visual name="bin_1_wall_xb_vis">
        <geometry><box><size>0.005 0.29 0.015</size></box></geometry>
        <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
      </visual>
    </link>
    <link name="bin_1_wall_near">
      <pose frame="">0.0000 -0.1900 0.0325 0 0 0.0000</pose>
      <collision name="bin_1_wall_near_col">
        <geometry><box><size>0.29 0.005 0.015</size></box></geometry>
      </collision>
      <visual name="bin_1_wall_near_vis">
        <geometry><box><size>0.29 0.005 0.015</size></box></geometry>
        <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
      </visual>
    </link>
  </model>

  <!-- 观众相机: 正前斜俯视取景(替代 gzclient 录屏, 避免 GUI 渲染拖垮 RTF) -->
  <model name="audience_cam">
    <static>true</static>
    <pose frame="">0.75 0 0.55 0 0.588 3.1416</pose>
    <link name="audience_cam_link">
      <sensor name="audience_cam_sensor" type="camera">
        <pose frame="">0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.05</horizontal_fov>
          <image><width>768</width><height>432</height></image>
          <clip><near>0.05</near><far>10.0</far></clip>
        </camera>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <plugin name="audience_cam_controller" filename="libgazebo_ros_camera.so">
          <ros><namespace>/</namespace></ros>
          <camera_name>audience_cam</camera_name>
          <frame_name>audience_cam_optical_frame</frame_name>
        </plugin>
      </sensor>
    </link>
  </model>

  <model name="top_camera">
    <static>true</static>
    <pose frame="">0 0 1.0 0 1.5708 0</pose>
    <link name="top_camera_link">
      <sensor name="top_camera_sensor" type="camera">
        <pose frame="">0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>0.95</horizontal_fov>
          <image><width>800</width><height>640</height></image>
          <clip><near>0.05</near><far>10.0</far></clip>
        </camera>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <plugin name="top_camera_controller" filename="libgazebo_ros_camera.so">
          <!-- 实测：插件默认把 model 名当命名空间，camera_name 再拼一层，
               会得到 /top_camera/top_camera/image_raw。
               显式把命名空间压到根，camera_name 就是唯一前缀。 -->
          <ros><namespace>/</namespace></ros>
          <camera_name>top_camera</camera_name>
          <frame_name>top_camera_optical_frame</frame_name>
        </plugin>
      </sensor>
    </link>
  </model>

  </world>
</sdf>
