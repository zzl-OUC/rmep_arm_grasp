      <geometry><box size="0.03 0.03 0.03"/></geometry>
    </collision>
  </link>
  <joint name="left_gripper_joint_5" type="fixed">
    <origin xyz="0.0385916 0.0103143 1.6e-06" rpy="0 0 0"/>
    <parent link="left_gripper_link_4"/><child link="left_gripper_link_5"/>
