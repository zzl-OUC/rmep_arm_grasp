      <geometry><box size="0.03 0.03 0.03"/></geometry>
    </collision>
  </link>

  <!-- ================= 右指（镜像） ================= -->
  <joint name="gripper_right_joint" type="revolute">
    <origin xyz="0.0163034 -0.0209781 -0.0399201" rpy="0 0 0"/>
    <parent link="gripper_link"/><child link="right_gripper_link_1"/>
